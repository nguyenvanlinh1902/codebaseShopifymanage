{
  "private": true,
  "name": "@linhnv/app",
  "description": "A simple Firebase Functions app with React frontend",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "setup:pubsub": "node scripts/setup-pubsub.js",
    "setup:bigquery": "node scripts/setup-bigquery.js",
    "build": "yarn workspace @linhnv/assets run production && yarn workspace @linhnv/functions run production",
    "build:frontend": "yarn workspace @linhnv/assets run production",
    "build:backend": "yarn workspace @linhnv/functions run production",
    "deploy": "./node_modules/.bin/firebase deploy",
    "deploy:full": "bash scripts/deploy.sh",
    "deploy:functions": "bash scripts/deploy.sh functions",
    "deploy:hosting": "bash scripts/deploy.sh hosting",
    "deploy:firestore": "bash scripts/deploy.sh firestore",
    "serve": "./node_modules/.bin/firebase serve",
    "logs": "./node_modules/.bin/firebase functions:log",
    "emulators": "GOOGLE_APPLICATION_CREDENTIALS=serviceAccount.development.json NODE_ENV=development ./node_modules/.bin/firebase emulators:start --only hosting,functions,pubsub",
    "predeploy": "yarn workspace @linhnv/assets run production && yarn workspace @linhnv/functions run production",
    "dev": "concurrently \"yarn workspace @linhnv/assets run watch\" \"yarn workspace @linhnv/functions run watch\"",
    "eslint-fix": "npm --prefix packages/assets/ run eslint-fix && npm --prefix packages/functions/ run eslint-fix"
  },
  "devDependencies": {
    "eslint": "^6.3.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^6.2.0",
    "eslint-plugin-prettier": "^3.1.0",
    "eslint-plugin-react": "^7.16.0",
    "firebase-tools": "^13.35.1",
    "prettier": "^1.18.2"
  },
  "dependencies": {
    "concurrently": "^7.6.0"
  },
  "packageManager": "yarn@4.13.0"
}
