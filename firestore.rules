rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /backgroundUploadVideo/{document} {
      allow read: if true;
    }
    match /product_imports/{document} {
      allow read: if true;
    }
    match /tracking_check_jobs/{document} {
      allow read: if true;
    }
  }
}
